MONGODB_URI=mongodb://localhost:27017/aura-school-system
PORT=3000
JWT_SECRET= <Key>
JWT_EXPIRE_IN=1d

# Comma-separated extra allowed CORS origins.
CORS_ORIGIN=

# How many reverse proxies sit in front of this app.
#
# Optional — defaults to 1, which is correct for Coolify/Traefik alone.
# Add 1 for every extra proxy (Cloudflare in front of Coolify = 2).
#
# This is a security control, not a performance setting. It is what stops a
# caller from forging X-Forwarded-For to pass the school-network check in
# teacher check-in. Too low and legitimate check-ins fail; too high and the
# check can be spoofed.
#
# Verify after any change: call GET /teacher-attendance/detect-ip normally,
# then again sending a junk X-Forwarded-For header. The answer must NOT change.
TRUST_PROXY_HOPS=1

# Forces every one-time password to this value, for testing.
#
# The OTP used to be hardcoded to 000000 in the source, which meant anyone who
# knew an email address could reset that account. It is random now; this
# variable brings the predictable code back when you need it.
#
# Leave it UNSET anywhere real. It is ignored when NODE_ENV=production, and
# the app logs an error if it is set there.
# OTP_FIXED_CODE=000000

# ─── Email ────────────────────────────────────────────────────────────
#
# Password reset and student password setup are the only things that send
# mail. Without these the app still boots, but those emails go nowhere — and
# it says so loudly in the log rather than failing quietly.
#
# The SMTP host, account and password used to be literals in email.service.ts,
# committed to the repository.

MAIL_PROVIDER=smtp
MAIL_FROM=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gmail is a stopgap. A normal account caps at roughly 500 messages a day, and
# mail from a personal address claiming to be a school lands in spam because
# the school's domain publishes no SPF or DKIM record for it.
#
# Switching provider is an environment change, not a code change:
#
#   MAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   MAIL_FROM=no-reply@your-verified-domain.com
#
# RESEND_API_KEY=

# ── Push notifications (optional) ────────────────────────────────
# Leave these unset and the app runs exactly as before: notices are written
# and the in-app bell shows them, but nothing is pushed to a closed app.
#
# From Firebase Console → Project settings → Service accounts →
# Generate new private key. Take the three values out of the downloaded JSON;
# do NOT commit the file itself.
#
# FIREBASE_PRIVATE_KEY must keep its \n sequences escaped and be quoted.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── WhatsApp credential delivery (optional) ──────────────────────
# When a student or teacher account is given a password, their login details
# are sent to the phone number on their record over WhatsApp.
#
# Nasaq does not talk to WhatsApp itself. It posts a signed event to an n8n
# workflow, and n8n owns the Arabic wording and the Evolution API call — so
# changing what the message says is an edit in n8n, not a deploy of this app.
# The workflow to import is in n8n/nasaq-whatsapp-credentials.json,
# and the full setup is docs/SETUP-WhatsApp-Credentials.md.
#
# Leave WHATSAPP_WEBHOOK_URL unset and nothing is sent. Events are still
# recorded as `skipped`, visible at GET /messaging/deliveries, so the feature
# is never silently doing nothing.
#
# WHATSAPP_WEBHOOK_SECRET must match NASAQ_WEBHOOK_SECRET on the n8n side.
# Without it the body goes unsigned and anyone who learns the URL can post
# fake credentials into the school's WhatsApp. Generate one with:
#   openssl rand -hex 32
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# Country code applied to a local number like 0501234567. Digits, no '+'.
# 966 Saudi · 20 Egypt · 971 UAE
WHATSAPP_DEFAULT_COUNTRY=966

# Set to false to stop sending without removing the configuration.
WHATSAPP_ENABLED=true
