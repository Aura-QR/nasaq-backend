MONGODB_URI=mongodb://localhost:27017/aura-school-system
PORT=3000
JWT_SECRET= <Key>
JWT_EXPIRE_IN=1d

# Comma-separated extra allowed CORS origins.
CORS_ORIGIN=

# How many reverse proxies sit in front of this app.
#
# Optional — defaults to 1, which is correct for Coolify/Traefik alone.
# Add 1 for every extra proxy (Cloudflare in front of Coolify = 2).
#
# This is a security control, not a performance setting. It is what stops a
# caller from forging X-Forwarded-For to pass the school-network check in
# teacher check-in. Too low and legitimate check-ins fail; too high and the
# check can be spoofed.
#
# Verify after any change: call GET /teacher-attendance/detect-ip normally,
# then again sending a junk X-Forwarded-For header. The answer must NOT change.
TRUST_PROXY_HOPS=1

# Forces every one-time password to this value, for testing.
#
# The OTP used to be hardcoded to 000000 in the source, which meant anyone who
# knew an email address could reset that account. It is random now; this
# variable brings the predictable code back when you need it.
#
# Leave it UNSET anywhere real. It is ignored when NODE_ENV=production, and
# the app logs an error if it is set there.
# OTP_FIXED_CODE=000000
