{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:super-admin": "ts-node src/platform/seed-super-admin.ts",
    "db:reset": "ts-node src/scripts/reset-db.ts",
    "migrate:timetable": "ts-node -r tsconfig-paths/register src/scripts/migrate-timetable-indexes.ts",
    "migrate:timetable:dry": "ts-node -r tsconfig-paths/register src/scripts/migrate-timetable-indexes.ts --dry-run",
    "migrate:preparation-week": "ts-node -r tsconfig-paths/register src/scripts/backfill-preparation-week.ts",
    "migrate:preparation-week:dry": "ts-node -r tsconfig-paths/register src/scripts/backfill-preparation-week.ts --dry-run",
    "repair:preparation-lectures": "ts-node -r tsconfig-paths/register src/scripts/repair-preparation-lectures.ts",
    "seed:mwahb": "ts-node src/scripts/seed-mwahb.ts",
    "cleanup:dup-teachers": "ts-node src/scripts/cleanup-duplicate-teachers.ts",
    "cleanup:classes": "ts-node src/scripts/cleanup-stray-classes.ts",
    "generate:timetable": "ts-node src/scripts/generate-timetable.ts",
    "merge:dup-teachers": "ts-node src/scripts/merge-duplicate-teachers.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@casl/mongoose": "^8.0.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.1",
    "@types/archiver": "^7.0.0",
    "@types/nodemailer": "^7.0.11",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "^14.3.0",
    "mongoose": "^8.0.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
